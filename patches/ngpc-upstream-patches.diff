diff --git a/rtl/soc/t900_mcu.sv b/rtl/soc/t900_mcu.sv
index cc899cf..4f66ee1 100644
--- a/rtl/soc/t900_mcu.sv
+++ b/rtl/soc/t900_mcu.sv
@@ -474,6 +474,36 @@ module t900_mcu
 	assign cs_n = cs_n_i;
 
 	// Serial channels: 0x50-0x58, tap words 0x18-0x1B
+`ifdef NGPC_NO_LINK
+	// The TMP95C061's serial channels drive the NGP's link connector. This
+	// build has no wiring to that connector, and the port costs 457 ALUTs on a
+	// device that is 99.7% full with saves and savestates both present -- so it
+	// is compiled out rather than dropped, and this define brings it back.
+	//
+	// Worth bringing back: the Pocket's cartridge slot carries GBA-style link
+	// pins (port_tran_si/so/sck/sd reach core_top), so the link is reachable in
+	// principle, not just in theory.
+	//
+	// What a game sees instead: the SC0/SC1 registers read as zero, which is
+	// their reset state, and no receive or transmit interrupt is ever raised.
+	// A title that polls the link finds it permanently idle. A title that waits
+	// on a transfer completing would wait forever -- no NGP software does that
+	// without a cable present, but it is the failure this trades for the area.
+	assign rd_sio      = 8'h00;
+	assign ss_rd_sio   = 32'd0;
+	assign intrx       = 2'd0;
+	assign inttx       = 2'd0;
+	assign intrx_clear = 2'd0;
+	assign txd0_i      = 1'b1;      // mark / idle
+	assign txd1_i      = 1'b1;
+	assign txd0_oe     = 1'b0;
+	assign txd1_oe     = 1'b0;
+	assign sclk0_i     = 1'b0;
+	assign sclk1_i     = 1'b0;
+	assign sclk0_oe    = 1'b0;
+	assign sclk1_oe    = 1'b0;
+	assign pr_sio      = 1'b1;      // nothing to drain, always ready to pause
+`else
 	ngp_sio u_sio
 	(
 		.clk(clk),
@@ -517,6 +547,7 @@ module t900_mcu
 		.pause_req(pause_req),
 		.pause_ready(pr_sio)
 	);
+`endif
 
 	assign txd0    = txd0_i;
 	assign txd1    = txd1_i;
