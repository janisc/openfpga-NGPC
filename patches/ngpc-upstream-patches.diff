@@ -630,6 +630,21 @@ module k2_soc
 	// RAM cheats behave alike. Writes, memory taps and cartridge backing traffic
 	// never pass through it. bus_rdy is observed only to rescan compare records
 	// once the raw response is valid; the engine never changes readiness.
+`ifdef NGPC_NO_CHEATS
+	// Cheats reach this core as a MiSTer cheat file. A build with no way to
+	// deliver one still pays for the engine: its comparators sit on the CPU's
+	// read path, between the fabric's raw response and the sequencer, and its
+	// four record tables occupy block RAM. With no table ever written the
+	// engine is a pass-through, but nothing in synthesis can prove that, so
+	// the whole compare cone survives.
+	//
+	// Bypassing it is exact: data_o is data_i whenever no record matches, and
+	// no record can exist. available_o and commit_done_o are only observed by
+	// the unused-signal guard above.
+	assign bus_rdata         = bus_rdata_raw;
+	assign cheat_available   = 1'b0;
+	assign cheat_commit_done = 1'b0;
+`else
 	ngp_cheat_engine cheat_engine
 	(
 		.clk_sys_i        (clk_sys),
@@ -649,6 +664,7 @@ module k2_soc
 		.available_o      (cheat_available),
 		.commit_done_o    (cheat_commit_done)
 	);
+`endif
 
