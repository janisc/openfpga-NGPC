+`ifdef NGPC_NO_CHEATS
+	// Cheats reach this core as a MiSTer cheat file. A build with no way to
+	// deliver one still pays for the engine: its comparators sit on the CPU's
+	// read path, between the fabric's raw response and the sequencer, and its
