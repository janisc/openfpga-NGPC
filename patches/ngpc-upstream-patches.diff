+	// 0x6F8B = year - 1900, 0x6F8C = month, 0x6F8D = day, all BINARY --
+	// unlike the BCD RTC. 14'h0 disables the writes.
+	// (Removed from the build for area; the confirmed address stays on
+	// record: 0x6F8B=year-1900, 0x6F8C=month, 0x6F8D=day, binary.)
+	parameter P_BIRTH_ADDR = 14'h0
 )
