# ==============================================================================
# NGPC for Analogue Pocket
# ==============================================================================
# Do NOT add files through the Quartus GUI -- add them to ngpc_upstream.qip or
# target/pocket/core.qip instead, or Quartus will rewrite this file.
# ==============================================================================

set_global_assignment -name TOP_LEVEL_ENTITY apf_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# ---- Compiler ----------------------------------------------------------------
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name SAVE_DISK_SPACE OFF
set_global_assignment -name SEED 1

# ---- Analysis & Synthesis ----------------------------------------------------
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
set_global_assignment -name MUX_RESTRUCTURE OFF
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name SAFE_STATE_MACHINE ON
set_global_assignment -name SYNTH_PROTECT_SDC_CONSTRAINT ON

# ---- Fitter ------------------------------------------------------------------
set_global_assignment -name ACTIVE_SERIAL_CLOCK FREQ_100MHZ
set_global_assignment -name CRC_ERROR_OPEN_DRAIN ON
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON
set_global_assignment -name FITTER_AGGRESSIVE_ROUTABILITY_OPTIMIZATION ALWAYS
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT LOW
set_global_assignment -name NUM_PARALLEL_PROCESSORS 6

# ---- Core defines ------------------------------------------------------------
# NGPC_POCKET     selects the native presenter over the CRT frame store.
# SYNTHESIS       selects the altddio I/O-cell capture path in sdram.sv.
# TV80_REFRESH    required: without it tv80 emits no refresh cycle.
# NGPC_DOT_BURST  upstream's shipped scanout timing (see upstream files.qip).
set_global_assignment -name VERILOG_MACRO "NGPC_POCKET=1"
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"
set_global_assignment -name VERILOG_MACRO "TV80_REFRESH=1"
set_global_assignment -name VERILOG_MACRO "NGPC_DOT_BURST=1"
set_global_assignment -name VERILOG_MACRO "NGPC_BURST_START=60"

# ---- Platform / core ---------------------------------------------------------
source ../platform/pocket/pocket.tcl
set_global_assignment -name QIP_FILE ../platform/pocket/apf.qip
set_global_assignment -name QIP_FILE ../target/pocket/core.qip
set_global_assignment -name QIP_FILE ngpc_upstream.qip

# Upstream's machine timing exceptions, then the members this device adds.
set_global_assignment -name SDC_FILE ../upstream/NGPC.sdc
set_global_assignment -name SDC_FILE ../target/pocket/ngpc_pocket_timing.sdc

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

set_global_assignment -name LAST_QUARTUS_VERSION "17.1.0 Lite Edition"