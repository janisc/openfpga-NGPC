FUNCTION a_dpfifo_r791 (clock, data[42..0], rreq, sclr, wreq)
RETURNS ( empty, full, q[42..0]);

--synthesis_resources = lut 26 M10K 3 reg 43 
SUBDESIGN scfifo_kaa1
( 
	aclr	:	input;
	clock	:	input;
	data[42..0]	:	input;
	empty	:	output;
	full	:	output;
	q[42..0]	:	output;
	rdreq	:	input;
	sclr	:	input;
	wrreq	:	input;
) 
VARIABLE 
	dpfifo : a_dpfifo_r791;
	const_node_aclr	: NODE;

BEGIN 
	dpfifo.clock = clock;
	dpfifo.data[] = data[];
	dpfifo.rreq = rdreq;
	dpfifo.sclr = sclr;
	dpfifo.wreq = wrreq;
	const_node_aclr = aclr;
	empty = dpfifo.empty;
	full = dpfifo.full;
	q[] = dpfifo.q[];
END;
