--a_graycounter DEVICE_FAMILY="Cyclone V" PVALUE=1 WIDTH=3 clock cnt_en q
--VERSION_BEGIN 25.1 cbx_a_gray2bin 2025:10:22:10:31:27:SC cbx_a_graycounter 2025:10:22:10:31:27:SC cbx_cycloneii 2025:10:22:10:31:27:SC cbx_mgl 2025:10:22:10:31:44:SC cbx_stratix 2025:10:22:10:31:27:SC cbx_stratixii 2025:10:22:10:31:26:SC  VERSION_END


