FUNCTION a_graycounter_7g6 (clock, cnt_en)
RETURNS ( q[2..0]);
FUNCTION a_graycounter_3ub (clock, cnt_en)
RETURNS ( q[2..0]);
FUNCTION altsyncram_m0i1 (address_a[1..0], address_b[1..0], addressstall_b, clock0, clock1, clocken1, data_a[15..0], wren_a)
RETURNS ( q_b[15..0]);
FUNCTION alt_synch_pipe_c9l (clock, d[2..0])
RETURNS ( q[2..0]);
FUNCTION alt_synch_pipe_b9l (clock, d[2..0])
RETURNS ( q[2..0]);
FUNCTION cmpr_qu5 (dataa[1..0], datab[1..0])
RETURNS ( aeb);
FUNCTION cmpr_pu5 (dataa[0..0], datab[0..0])
RETURNS ( aeb);
FUNCTION mux_5r7 (data[1..0], sel[0..0])
RETURNS ( result[0..0]);

--synthesis_resources = lut 16 reg 142 
OPTIONS ALTERA_INTERNAL_OPTION = "AUTO_SHIFT_REGISTER_RECOGNITION=OFF;REMOVE_DUPLICATE_REGISTERS=OFF;SYNCHRONIZER_IDENTIFICATION=OFF;SYNCHRONIZATION_REGISTER_CHAIN_LENGTH = 3;suppress_da_rule_internal=d101;suppress_da_rule_internal=d102;suppress_da_rule_internal=d103;{-to rdemp_eq_comp_lsb_aeb} SYNCHRONIZER_IDENTIFICATION=FORCED_IF_ASYNCHRONOUS;{-to rdemp_eq_comp_lsb_aeb} PRESERVE_REGISTER=ON;{-to rdemp_eq_comp_lsb_aeb} POWER_UP_LEVEL=HIGH;{-to rdemp_eq_comp_msb_aeb} SYNCHRONIZER_IDENTIFICATION=FORCED_IF_ASYNCHRONOUS;{-to rdemp_eq_comp_msb_aeb} PRESERVE_REGISTER=ON;{-to rdemp_eq_comp_msb_aeb} POWER_UP_LEVEL=HIGH;{-to rs_dgwp_reg} SYNCHRONIZER_IDENTIFICATION=FORCED_IF_ASYNCHRONOUS;{-to rs_dgwp_reg} PRESERVE_REGISTER=ON;{-to wrfull_eq_comp_lsb_mux_reg} SYNCHRONIZER_IDENTIFICATION=FORCED_IF_ASYNCHRONOUS;{-to wrfull_eq_comp_lsb_mux_reg} PRESERVE_REGISTER=ON;{-to wrfull_eq_comp_msb_mux_reg} SYNCHRONIZER_IDENTIFICATION=FORCED_IF_ASYNCHRONOUS;{-to wrfull_eq_comp_msb_mux_reg} PRESERVE_REGISTER=ON;{-to wrptr_g} suppress_da_rule_internal=S102;{-to wrptr_g} POWER_UP_LEVEL=LOW;{-to ws_dgrp_reg} SYNCHRONIZER_IDENTIFICATION=FORCED_IF_ASYNCHRONOUS;{-to ws_dgrp_reg} PRESERVE_REGISTER=ON;-name CUT ON -from delayed_wrptr_g -to rs_dgwp|dffpipe_tu8:dffpipe3|dffe4a;-name SDC_STATEMENT ""set_false_path -from *delayed_wrptr_g* -to *rs_dgwp|dffpipe_tu8:dffpipe3|dffe4a* """;

SUBDESIGN dcfifo_u5o1
( 
	data[15..0]	:	input;
	q[15..0]	:	output;
	rdclk	:	input;
	rdempty	:	output;
	rdreq	:	input;
	wrclk	:	input;
	wrreq	:	input;
) 
VARIABLE 
	rdptr_g1p : a_graycounter_7g6;
	wrptr_g1p : a_graycounter_3ub;
	fifo_ram : altsyncram_m0i1;
	delayed_wrptr_g[2..0] : dffe;
	rdemp_eq_comp_lsb_aeb : dffe
		WITH (
			power_up = "high"
		);
	rdemp_eq_comp_msb_aeb : dffe
		WITH (
			power_up = "high"
		);
	rdptr_g[2..0] : dffe;
	rs_dgwp_reg[2..0] : dffe;
	wrfull_eq_comp_lsb_mux_reg : dffe;
	wrfull_eq_comp_msb_mux_reg : dffe;
	wrptr_g[2..0] : dffe
		WITH (
			power_up = "low"
		);
	ws_dgrp_reg[2..0] : dffe;
	rs_dgwp : alt_synch_pipe_c9l;
	ws_dgrp : alt_synch_pipe_b9l;
	rdempty_eq_comp1_lsb : cmpr_qu5;
	rdempty_eq_comp1_msb : cmpr_pu5;
	rdempty_eq_comp_lsb : cmpr_qu5;
	rdempty_eq_comp_msb : cmpr_pu5;
	wrfull_eq_comp1_lsb : cmpr_qu5;
	wrfull_eq_comp1_msb : cmpr_pu5;
	wrfull_eq_comp_lsb : cmpr_qu5;
	wrfull_eq_comp_msb : cmpr_pu5;
	rdemp_eq_comp_lsb_mux : mux_5r7;
	rdemp_eq_comp_msb_mux : mux_5r7;
	wrfull_eq_comp_lsb_mux : mux_5r7;
	wrfull_eq_comp_msb_mux : mux_5r7;
	int_rdempty	: WIRE;
	ram_address_a[1..0]	: WIRE;
	ram_address_b[1..0]	: WIRE;
	valid_rdreq	: WIRE;
	valid_wrreq	: WIRE;
	wrptr_g1s[2..0]	: WIRE;
	wrptr_gs[2..0]	: WIRE;

BEGIN 
	rdptr_g1p.clock = rdclk;
	rdptr_g1p.cnt_en = valid_rdreq;
	wrptr_g1p.clock = wrclk;
	wrptr_g1p.cnt_en = valid_wrreq;
	fifo_ram.address_a[] = ram_address_a[];
	fifo_ram.address_b[] = ram_address_b[];
	fifo_ram.addressstall_b = (! valid_rdreq);
	fifo_ram.clock0 = wrclk;
	fifo_ram.clock1 = rdclk;
	fifo_ram.clocken1 = valid_rdreq;
	fifo_ram.data_a[] = data[];
	fifo_ram.wren_a = valid_wrreq;
	delayed_wrptr_g[].clk = wrclk;
	delayed_wrptr_g[].d = wrptr_g[].q;
	rdemp_eq_comp_lsb_aeb.clk = rdclk;
	rdemp_eq_comp_lsb_aeb.d = rdemp_eq_comp_lsb_mux.result[];
	rdemp_eq_comp_msb_aeb.clk = rdclk;
	rdemp_eq_comp_msb_aeb.d = rdemp_eq_comp_msb_mux.result[];
	rdptr_g[].clk = rdclk;
	rdptr_g[].d = rdptr_g1p.q[];
	rdptr_g[].ena = valid_rdreq;
	rs_dgwp_reg[].clk = rdclk;
	rs_dgwp_reg[].d = rs_dgwp.q[];
	wrfull_eq_comp_lsb_mux_reg.clk = wrclk;
	wrfull_eq_comp_lsb_mux_reg.d = wrfull_eq_comp_lsb_mux.result[];
	wrfull_eq_comp_msb_mux_reg.clk = wrclk;
	wrfull_eq_comp_msb_mux_reg.d = wrfull_eq_comp_msb_mux.result[];
	wrptr_g[].clk = wrclk;
	wrptr_g[].d = wrptr_g1p.q[];
	wrptr_g[].ena = valid_wrreq;
	ws_dgrp_reg[].clk = wrclk;
	ws_dgrp_reg[].d = ws_dgrp.q[];
	rs_dgwp.clock = rdclk;
	rs_dgwp.d[] = delayed_wrptr_g[].q;
	ws_dgrp.clock = wrclk;
	ws_dgrp.d[] = rdptr_g[].q;
	rdempty_eq_comp1_lsb.dataa[1..0] = rs_dgwp.q[1..0];
	rdempty_eq_comp1_lsb.datab[1..0] = rdptr_g1p.q[1..0];
	rdempty_eq_comp1_msb.dataa[0..0] = rs_dgwp.q[2..2];
	rdempty_eq_comp1_msb.datab[0..0] = rdptr_g1p.q[2..2];
	rdempty_eq_comp_lsb.dataa[1..0] = rs_dgwp.q[1..0];
	rdempty_eq_comp_lsb.datab[1..0] = rdptr_g[1..0].q;
	rdempty_eq_comp_msb.dataa[0..0] = rs_dgwp.q[2..2];
	rdempty_eq_comp_msb.datab[0..0] = rdptr_g[2..2].q;
	wrfull_eq_comp1_lsb.dataa[1..0] = ws_dgrp.q[1..0];
	wrfull_eq_comp1_lsb.datab[1..0] = wrptr_g1s[1..0];
	wrfull_eq_comp1_msb.dataa[0..0] = ws_dgrp.q[2..2];
	wrfull_eq_comp1_msb.datab[0..0] = wrptr_g1s[2..2];
	wrfull_eq_comp_lsb.dataa[1..0] = ws_dgrp.q[1..0];
	wrfull_eq_comp_lsb.datab[1..0] = wrptr_gs[1..0];
	wrfull_eq_comp_msb.dataa[0..0] = ws_dgrp.q[2..2];
	wrfull_eq_comp_msb.datab[0..0] = wrptr_gs[2..2];
	rdemp_eq_comp_lsb_mux.data[] = ( rdempty_eq_comp1_lsb.aeb, rdempty_eq_comp_lsb.aeb);
	rdemp_eq_comp_lsb_mux.sel[] = valid_rdreq;
	rdemp_eq_comp_msb_mux.data[] = ( rdempty_eq_comp1_msb.aeb, rdempty_eq_comp_msb.aeb);
	rdemp_eq_comp_msb_mux.sel[] = valid_rdreq;
	wrfull_eq_comp_lsb_mux.data[] = ( wrfull_eq_comp1_lsb.aeb, wrfull_eq_comp_lsb.aeb);
	wrfull_eq_comp_lsb_mux.sel[] = valid_wrreq;
	wrfull_eq_comp_msb_mux.data[] = ( wrfull_eq_comp1_msb.aeb, wrfull_eq_comp_msb.aeb);
	wrfull_eq_comp_msb_mux.sel[] = valid_wrreq;
	int_rdempty = (rdemp_eq_comp_lsb_aeb.q & rdemp_eq_comp_msb_aeb.q);
	q[] = fifo_ram.q_b[];
	ram_address_a[] = ( (wrptr_g[2..2].q $ wrptr_g[1..1].q), wrptr_g[0..0].q);
	ram_address_b[] = ( (rdptr_g1p.q[2..2] $ rdptr_g1p.q[1..1]), rdptr_g1p.q[0..0]);
	rdempty = int_rdempty;
	valid_rdreq = rdreq;
	valid_wrreq = wrreq;
	wrptr_g1s[] = ( (! wrptr_g1p.q[2..2]), (! wrptr_g1p.q[1..1]), wrptr_g1p.q[0..0]);
	wrptr_gs[] = ( (! wrptr_g[2..2].q), (! wrptr_g[1..1].q), wrptr_g[0..0].q);
END;
--VALID FILE
